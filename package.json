{
  "name": "inventory-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":           "nodemon app.js",
    "start":         "node app.js",

    "pm2:start":     "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop":      "pm2 stop inventory-server",
    "pm2:restart":   "pm2 restart inventory-server",
    "pm2:delete":    "pm2 delete inventory-server",
    "pm2:list":      "pm2 list",
    "pm2:logs":      "pm2 logs inventory-server",
    "pm2:logs:err":  "pm2 logs inventory-server --err",
    "pm2:monit":     "pm2 monit",

    "db:generate":   "prisma generate",
    "db:migrate":    "prisma migrate dev",
    "db:deploy":     "prisma migrate deploy",
    "db:studio":     "prisma studio",
    "db:seed":       "node src/utils/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors":           "^2.8.5",
    "dotenv":         "^16.4.5",
    "express":        "^4.18.3",
    "multer":         "^1.4.5-lts.1",
    "xlsx":           "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma":  "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}